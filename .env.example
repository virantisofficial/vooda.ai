# Vooda AI — environment variables for Coolify / docker-compose deploy.
#
# Copy this file to `.env` next to docker-compose.yml and fill in the
# required values. The `.env` file is git-ignored — never commit
# secrets.
#
# Generate strong secrets with:
#   openssl rand -base64 32   # POSTGRES_PASSWORD
#   openssl rand -hex 32      # SECRET_KEY

# ─── Required ─────────────────────────────────────────────────

# Postgres superuser password — used by db, api, worker, beat.
# Compose fails to start if this isn't set (`${VAR:?}` enforcement
# in docker-compose.yml).
POSTGRES_PASSWORD=

# App-wide signing key for JWTs + OAuth state. Must be ≥32 random
# bytes. Compose fails to start if this isn't set.
SECRET_KEY=

# AI provider key — required for AI triage. Set the one matching
# AI_PROVIDER below.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Recommended for production ───────────────────────────────

# Public-facing URL where the SPA lives. Used in deep-links (Jira
# tickets, Slack notifications, "View in Vooda" buttons).
WEB_BASE_URL=http://localhost:3000

# Comma-separated list of CORS origins. Default is the dev frontend.
CORS_ORIGINS=http://localhost:3000

# OAuth callback base — must match what's registered in Atlassian /
# GitHub developer consoles. Format:
#   https://<your-domain>/api/v1/integrations/oauth
OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/integrations/oauth

# ─── Optional — defaults are fine for most deployments ────────

# Database connection (defaults to vooda/vooda)
POSTGRES_USER=vooda
POSTGRES_DB=vooda

# AI engine selection
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-4-20250514

# Storage backend (`local` writes to a docker volume; `s3` requires
# additional S3_* vars)
STORAGE_BACKEND=local

# Logging
LOG_LEVEL=INFO

# Process counts — bump if you have CPU + RAM headroom
API_WORKERS=2
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=info

# ─── Build-time (docker compose build) ────────────────────────
# Where the web container reaches the API over the docker network.
# Must be set at BUILD time because Next.js bakes it into the route
# map. Compose passes this to Dockerfile.web via --build-arg.
# The default works for the standard compose setup; only override
# if you renamed the api service.
# API_INTERNAL_URL=http://api:8000

# ─── Seed script overrides (one-time, only used by seed.py) ───
# There is no default admin password. Leave SEED_ADMIN_PASSWORD unset
# and the seed generates a strong one and prints it once — nothing
# stores it, so copy it when you see it. Set it here only if you want
# to choose the password yourself.
# SEED_ADMIN_EMAIL=you@your-domain.com
# SEED_ADMIN_PASSWORD=
#
# The dev user is only created if you give it a password.
# SEED_DEV_EMAIL=
# SEED_DEV_PASSWORD=
